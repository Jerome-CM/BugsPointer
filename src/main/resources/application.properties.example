spring.application.name=BugsPointer
server.port=${SERVER_PORT:8080}
server.address=${SERVER_ADDRESS:127.0.0.1}

logging.level.org.springframework=INFO
spring.web.locale=fr_FR
spring.web.locale-resolver=fixed
server.forward-headers-strategy=framework
server.compression.enabled=true
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.secure=${SESSION_COOKIE_SECURE:true}
server.servlet.session.cookie.same-site=lax

################### DataSource Configuration ##########################
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL5Dialect
spring.datasource.url=${SPRING_DATASOURCE_URL}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}

################### Hibernate Configuration ##########################
spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.main.allow-circular-references=true
spring.mvc.pathmatch.matching-strategy=ANT_PATH_MATCHER

################### Security Configuration ##########################
jwt.secret=${JWT_SECRET}
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_OAUTH_CLIENT_ID:disabled}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_OAUTH_CLIENT_SECRET:disabled}
spring.security.oauth2.client.registration.google.scope=openid,email
spring.security.oauth2.client.registration.google.redirect-uri=${APP_BASE_URL:https://bugspointer.com}/login/oauth2/code/google
spring.security.oauth2.client.registration.github.client-id=${GITHUB_OAUTH_CLIENT_ID:disabled}
spring.security.oauth2.client.registration.github.client-secret=${GITHUB_OAUTH_CLIENT_SECRET:disabled}
spring.security.oauth2.client.registration.github.scope=user:email
spring.security.oauth2.client.registration.github.redirect-uri=${APP_BASE_URL:https://bugspointer.com}/login/oauth2/code/github

################### Mail Configuration ##########################
mail.smtp=${MAIL_SMTP}
mail.port=${MAIL_PORT:587}
mail.user=${MAIL_USER}
mail.password=${MAIL_PASSWORD}
mail.from.noreply=${MAIL_FROM_NOREPLY:noreply@bugspointer.com}
mail.from.contact=${MAIL_FROM_CONTACT:contact@bugspointer.com}
mail.from.name=${MAIL_FROM_NAME:BugsPointer}

################### SSL Configuration ##########################
server.ssl.enabled=${SERVER_SSL_ENABLED:false}
server.ssl.key-store=${SERVER_SSL_KEY_STORE:}
server.ssl.key-store-password=${SERVER_SSL_KEY_STORE_PASSWORD:}
server.ssl.key-store-type=${SERVER_SSL_KEY_STORE_TYPE:PKCS12}
server.ssl.key-alias=${SERVER_SSL_KEY_ALIAS:tomcat}

################### Payment Provider Configuration ##########################
mollie.key=${MOLLIE_KEY}

################### Metrics Configuration ##########################
metrics.excluded-ips=${METRICS_EXCLUDED_IPS:}
